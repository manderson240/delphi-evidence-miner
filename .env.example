# Delphi Competition API credentials (Mainnet key from https://api-access.delphi.fyi)
DELPHI_API_BASE_URL=https://delphi.fyi/v1
DELPHI_API_ACCESS_KEY=

# Agent metadata headers sent on API requests
DELPHI_AGENT_ID=delphi-evidence-miner
DELPHI_AGENT_HARNESS=delphi-evidence-miner/0.3
DELPHI_AGENT_MODEL=deepseek-v4-pro:cloud

# Stateless Ollama synthesizer endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-v4-pro:cloud
